<?xml version="1.0" encoding="utf-8"?>
<NsDepCopConfig>
    <Allowed From="*" To="*" />

    <Disallowed From="Parkin.Api.Features.*" To="Parkin.Api.Infrastructure.*" />

    <Disallowed From="Parkin.Api.Domain.*" To="Parkin.Api.Infrastructure.*" />
    <Disallowed From="Parkin.Api.Domain.*" To="Parkin.Api.Features.*" />
    <Disallowed From="Parkin.Api.Domain.*" To="Parkin.Api.Web.*" />

    <AnalyzerConfig>
        <IssueKind Name="IllegalDependency" Severity="Error" />
    </AnalyzerConfig>
</NsDepCopConfig>
